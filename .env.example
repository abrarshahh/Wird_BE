# Environment Configuration for Wird Backend (Wird_BE)
PROJECT_NAME="Wird Engine"
API_V1_PREFIX="/api/v1"
DEBUG=true

# Database Configuration
# Default: Local asynchronous SQLite (zero friction setup)
DATABASE_URL="sqlite+aiosqlite:///./data/wird.db"

# For PostgreSQL production, uncomment and update:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/wird_db"

# Data Directories
DATA_DIR="./data"
RAW_DATA_DIR="./data/raw"

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
